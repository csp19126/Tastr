# Copy to .env for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tastr_dev
# Comma-separated emails that get the admin screen when they sign up or log in.
ADMIN_EMAILS=
# Where photos are kept. On Railway, mount a volume here.
UPLOAD_DIR=./uploads
# Public address of this API, used to build photo links (e.g. https://api.example.com).
PUBLIC_URL=http://localhost:4000
# Google sign-in: the OAuth client IDs whose tokens we accept (web, iOS, Android), comma-separated.
GOOGLE_CLIENT_IDS=
# Password reset emails (resend.com). Without a key, development prints the code to this terminal.
RESEND_API_KEY=
EMAIL_FROM=Tastr <onboarding@resend.dev>
# Apple sign-in: the iOS bundle identifier(s), comma-separated.
APPLE_BUNDLE_IDS=
# Google sign-in on the web version: the "Web application" client ID (also accepted for sign-in).
GOOGLE_WEB_CLIENT_ID=
# Facebook sign-in (developers.facebook.com → App settings → Basic). The secret is a password.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Google Maps for the web version: a browser key locked to your site's address. Map ID is optional.
GOOGLE_MAPS_WEB_KEY=
GOOGLE_MAPS_MAP_ID=
